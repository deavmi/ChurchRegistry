doctype html
html
  include header


  body
    center
      div
      h1 Churches
      p Church management
      br
      h3 Edit an existing church

      - auto id = c.getId();

      form(action="/doChurchEdit?id=#{id}", method="post")
        div(class="form-row")
          div(class="form-group col-md-6")
            label(for="cn") Name of church
            input(type="text", class="form-control", name="churchName", id="cn", placeholder="#{c.name()}", value="#{c.name()}")
          div(class="form-group col-md-6")
            label(for="ca") Address
            input(type="text", class="form-control", name="churchAddress", id="ca", placeholder="#{c.city()}", value="#{c.city()}")
          div(class="form-group col-md-6")
            label(for="cp") Province
            input(type="text", class="form-control", name="churchProvince", id="cp", placeholder="#{c.province()}", value="#{c.province()}")

        button(type="submit", class="btn btn-primary") Save church