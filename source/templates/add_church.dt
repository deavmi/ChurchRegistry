doctype html
html
  include header


  body
    center
      div
      h1 Churches
      p Church management
      br
      h3 Add a new church

      form(action="/doChurchAdd",method="post")
        div(class="form-row")
          div(class="form-group col-md-6")
            label(for="cn") Name of church
            input(type="text", class="form-control", name="churchName", id="cn", placeholder="Place name here")
          div(class="form-group col-md-6")
            label(for="ca") Address
            input(type="text", class="form-control", name="churchAddress", id="ca", placeholder="Place address here")
          div(class="form-group col-md-6")
            label(for="cp") Province
            input(type="text", class="form-control", name="churchProvince", id="cp", placeholder="Place province here")

        button(type="submit", class="btn btn-primary") Save church